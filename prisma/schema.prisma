generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  PROVIDER
  ADMIN
}

enum ServiceType {
  WALKING
  SITTING
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  phone     String?
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())

  pets     Pet[]
  provider Provider?
  bookings Booking[] @relation("OwnerBookings")
  cartItems CartItem[]
  orders    Order[]
}

model Pet {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  name        String
  breed       String?
  size        PetSize  @default(MEDIUM)
  temperament String?
  notes       String?
  birthday          DateTime?
  weightKg          Float?
  allergies         String?
  medicalHistory    String?
  favoriteTreats    String?
  microchipId       String?
  insuranceProvider String?
  insurancePolicy   String?
  photoUrl          String?
  createdAt   DateTime @default(now())

  vaccinations Vaccination[]
  bookings     Booking[]
}

model Vaccination {
  id           String   @id @default(cuid())
  petId        String
  pet          Pet      @relation(fields: [petId], references: [id])
  vaccineName  String
  dateGiven    DateTime
  nextDueDate  DateTime
  reminderSent Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Provider {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  bio           String?
  servicesOffered ServiceType[]
  serviceAreaPin  String?
  radiusKm        Int      @default(5)
  pricePerWalk    Int? // in paise
  pricePerSitDay  Int? // in paise
  verified        Boolean  @default(false)
  ratingAvg       Float    @default(0)
  ratingCount     Int      @default(0)
  createdAt       DateTime @default(now())

  bookings Booking[]
}

model Booking {
  id           String        @id @default(cuid())
  type         ServiceType
  status       BookingStatus @default(REQUESTED)
  ownerId      String
  owner        User          @relation("OwnerBookings", fields: [ownerId], references: [id])
  providerId   String
  provider     Provider      @relation(fields: [providerId], references: [id])
  petId        String
  pet          Pet           @relation(fields: [petId], references: [id])
  startTime    DateTime
  endTime      DateTime
  priceAmount  Int // paise
  address      String?
  phone        String?
  latitude     Float?
  longitude    Float?
  razorpayOrderId String?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())

  report WalkReport?
  review Review?
}

model WalkReport {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  distanceKm Float?
  durationMin Int?
  photos     String[]
  notes      String?
  createdAt  DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  price       Int // paise
  imageUrl    String?
  icon        String? // fallback icon key when no photo yet
  stock       Int      @default(100)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING)
  totalAmount     Int // paise
  razorpayOrderId String?
  paidAt          DateTime?
  createdAt       DateTime    @default(now())

  items OrderItem[]
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id])
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  quantity         Int
  priceAtPurchase  Int // paise, snapshot at order time
}
