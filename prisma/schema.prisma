generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  PROVIDER
  ADMIN
}

enum ServiceType {
  WALKING
  SITTING
  GROOMING
  TRAINING
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum CartItemKind {
  PRODUCT
  SERVICE
}

enum ActivityType {
  PAGE_VIEW
  CLICK
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum PayoutMethod {
  BANK
  UPI
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum PawPointsTransactionType {
  EARNED             // real points earned from a real paid purchase
  REDEEMED           // real points spent to discount a real purchase
  EARNED_REVERSED    // clawback: the purchase that earned these points was refunded/cancelled
  REDEEMED_REVERSED  // refund: points spent on a purchase that was later refunded/cancelled are given back
}

enum PackageCadence {
  WEEKLY
  MONTHLY
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  phone     String?
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  pets     Pet[]
  provider Provider?
  bookings Booking[] @relation("OwnerBookings")
  cartItems CartItem[]
  orders    Order[]
  heroPhotos HeroPhoto[]
  showStockPhotos Boolean @default(true)
  address         String?
  addresses       Address[]
  activityEvents  ActivityEvent[]
  favorites       Favorite[]
  pawPointsTransactions PawPointsTransaction[]
}

model Address {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  label          String   @default("Home")
  fullAddress    String
  googleMapsLink String?
  receiverName   String
  receiverPhone  String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Pet {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  name        String
  breed       String?
  size        PetSize  @default(MEDIUM)
  temperament String?
  notes       String?
  birthday          DateTime?
  weightKg          Float?
  allergies         String?
  medicalHistory    String?
  favoriteTreats    String?
  microchipId       String?
  insuranceProvider String?
  insurancePolicy   String?
  photoUrl          String?
  themeOverride     String?
  createdAt   DateTime @default(now())

  vaccinations Vaccination[]
  bookings     Booking[]
  cartItems    CartItem[]
}

model HeroPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  url       String
  createdAt DateTime @default(now())
}

model Vaccination {
  id           String   @id @default(cuid())
  petId        String
  pet          Pet      @relation(fields: [petId], references: [id])
  vaccineName  String
  type         String   @default("VACCINE")
  dateGiven    DateTime
  nextDueDate  DateTime?
  reminderSent Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Provider {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  bio           String?
  photoUrl      String?
  servicesOffered ServiceType[]
  serviceAreaPin  String?
  radiusKm        Int      @default(5)
  pricePerWalk    Int?
  pricePerSitDay  Int?
  pricePerGroom   Int?
  pricePerTrain   Int?
  // Training: which billing cadence(s) this provider offers at all — each
  // TrainingPackage below belongs to exactly one of these. Grooming: which
  // dog sizes this provider grooms (reuses PetSize) — a preference, not
  // pricing itself; each GroomingPackage prices per size separately below.
  trainingCadences PackageCadence[] @default([])
  groomingSizes     PetSize[]        @default([])
  verified        Boolean  @default(false)
  ratingAvg       Float    @default(0)
  ratingCount     Int      @default(0)
  isAvailableNow  Boolean  @default(false)
  verificationDocs        String[] @default([])
  verificationSubmittedAt DateTime?
  // Sponsorship is scoped per service category, plus a separate broader
  // "homepage" tier — a provider can be featured in Walking without paying
  // for Grooming too, or pay more for the premium homepage-wide tier which
  // counts as sponsored everywhere regardless of category.
  sponsoredWalkingUntil  DateTime?
  sponsoredSittingUntil  DateTime?
  sponsoredGroomingUntil DateTime?
  sponsoredTrainingUntil DateTime?
  sponsoredHomepageUntil DateTime?
  createdAt       DateTime @default(now())

  // Manual payout info — providers submit either a bank account or a UPI
  // ID (never both required); admin transfers manually for now and marks
  // paid, until RazorpayX Payouts automation replaces the manual step
  // later without changing this data model.
  payoutMethod          PayoutMethod?
  bankAccountNumber     String?
  bankIFSC              String?
  bankAccountHolderName String?
  upiVpa                String?
  payoutInfoUpdatedAt   DateTime?

  bookings     Booking[]
  cartItems    CartItem[]
  availability ProviderAvailability[]
  sponsorshipPurchases SponsorshipPurchase[]
  favorites    Favorite[]
  campaigns    Campaign[]
  trainingPackages TrainingPackage[]
  groomingPackages GroomingPackage[]
  payouts      Payout[]
}

// A named, provider-created training package (e.g. "Puppy Basics"),
// belonging to exactly one of the provider's enabled cadences
// (trainingCadences on Provider) — a package can't exist under a cadence
// the provider hasn't turned on.
model TrainingPackage {
  id          String         @id @default(cuid())
  providerId  String
  provider    Provider       @relation(fields: [providerId], references: [id])
  name        String
  cadence     PackageCadence
  pricePaise  Int
  createdAt   DateTime       @default(now())
}

// A named, provider-created grooming package (e.g. "Base Bath & Brush"),
// priced separately per dog size. pricesBySize is keyed by PetSize value
// ("SMALL" | "MEDIUM" | "LARGE") to a paise amount — only sizes the
// provider actually grooms (Provider.groomingSizes) should have an entry,
// enforced in application code rather than at the schema level. Grooming
// is per-visit only, no cadence concept (unlike Training).
model GroomingPackage {
  id           String   @id @default(cuid())
  providerId   String
  provider     Provider @relation(fields: [providerId], references: [id])
  name         String
  pricesBySize Json     // e.g. { "SMALL": 3500, "MEDIUM": 4500, "LARGE": 6000 } — paise
  createdAt    DateTime @default(now())
}

model ProviderAvailability {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  dayOfWeek  Int
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())

  @@unique([providerId, dayOfWeek])
}

// A provider paying for a period of boosted visibility, scoped to one
// category (WALKING/SITTING/GROOMING/TRAINING) or the broader HOMEPAGE
// tier. Kept as its own audit-trail model so there's a real payment
// history, separate from the current-status fields on Provider itself.
model SponsorshipPurchase {
  id              String   @id @default(cuid())
  providerId      String
  provider        Provider @relation(fields: [providerId], references: [id])
  scope           String   @default("HOMEPAGE") // WALKING | SITTING | GROOMING | TRAINING | HOMEPAGE
  durationDays    Int      // 7 or 30
  amount          Int      // paise
  razorpayOrderId String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
}

model Campaign {
  id              String         @id @default(cuid())
  providerId      String
  provider        Provider       @relation(fields: [providerId], references: [id])
  name            String
  services        ServiceType[]
  dailyBudgetPaise Int
  // Required in practice (enforced in the API/form) since the one-time
  // Razorpay charge on launch is for exactly this amount — you can't
  // charge a fixed sum for an uncapped campaign. Budget Used (elapsed
  // active days × dailyBudgetPaise) is still checked against this to
  // auto-pause once reached.
  totalBudgetCapPaise Int?
  status          CampaignStatus @default(ACTIVE)
  startDate       DateTime
  endDate         DateTime?
  createdAt       DateTime       @default(now())
  // Same pattern as Booking/Order: the campaign exists in the DB as soon
  // as checkout starts, but is only real/active once paidAt is set. Every
  // read that matters (search boosting, History listing) filters on
  // paidAt not null, so an abandoned or failed payment never surfaces as
  // a working campaign.
  razorpayOrderId String?
  paidAt          DateTime?

  impressions CampaignImpression[]
  clicks      CampaignClick[]
}

// One row per real appearance of a provider in search results while an
// active campaign of theirs applied — logged the same way ActivityEvent
// already logs real page views, no deduplication, no estimation. Reach is
// just a count of these rows.
model CampaignImpression {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  createdAt  DateTime @default(now())

  @@index([campaignId])
}

// One row per real tap on "Choose" / "View Plans" for a provider whose
// active campaign caused that specific card to be boosted into view.
// Clicks is a count of these rows — never an estimate or a ratio applied
// to impressions.
model CampaignClick {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  createdAt  DateTime @default(now())

  @@index([campaignId])
}

model Booking {
  id           String        @id @default(cuid())
  type         ServiceType
  status       BookingStatus @default(REQUESTED)
  ownerId      String
  owner        User          @relation("OwnerBookings", fields: [ownerId], references: [id])
  providerId   String
  provider     Provider      @relation(fields: [providerId], references: [id])
  petId        String
  pet          Pet           @relation(fields: [petId], references: [id])
  startTime    DateTime
  endTime      DateTime
  priceAmount  Int
  address      String?
  phone        String?
  latitude     Float?
  longitude    Float?
  razorpayOrderId String?
  paidAt       DateTime?
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id])
  requestExpiresAt DateTime?
  cancelledBy  String?
  cancellationFeePaid Boolean @default(false)
  // Commission snapshot at booking time — priceAmount stays the BASE price
  // (platform-fixed for Walking, provider-set otherwise). These three
  // record what the owner actually paid in total and what the provider
  // actually earns, so historical bookings stay accurate even if
  // commission rates change later.
  maintenanceFeePaise Int?
  ownerTotalPaise     Int?
  providerPayoutPaise Int?
  // Same grooming package/size snapshot as CartItem, carried through by
  // finalizeRazorpayOrder when the cart item becomes a real booking — so
  // "what was actually booked" stays visible on the provider's Schedule
  // and the owner's history, not just a price with no detail.
  groomingPackageName String?
  groomingSize         PetSize?
  // Null = this booking's payout hasn't been claimed yet — it's counted
  // as "owed" to the provider. Set once a Payout is created that includes
  // it. No separate running-balance field on Provider, so there's nothing
  // that can drift out of sync with reality.
  payoutId     String?
  payout       Payout?       @relation(fields: [payoutId], references: [id])
  createdAt    DateTime      @default(now())

  report      WalkReport?
  review      Review?
  ownerReview OwnerReview?
  pawPointsTransactions PawPointsTransaction[]
}

// A manual payout run — created from a provider's unclaimed COMPLETED
// bookings. amountPaise is a snapshot taken at creation time (sum of the
// claimed bookings' providerPayoutPaise), not recomputed live, so it stays
// accurate even if commission rates change later. Admin transfers the
// money manually (bank/UPI) outside this system for now, then marks it
// paid with a reference number — same shape this table will keep once
// RazorpayX Payouts replaces the manual transfer step.
model Payout {
  id                String       @id @default(cuid())
  providerId        String
  provider          Provider     @relation(fields: [providerId], references: [id])
  amountPaise       Int
  status            PayoutStatus @default(PENDING)
  transferReference String?
  paidBy            String?
  requestedAt       DateTime     @default(now())
  paidAt            DateTime?

  bookings Booking[]
}

model WalkReport {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  distanceKm Float?
  durationMin Int?
  photos     String[]
  notes      String?
  createdAt  DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model OwnerReview {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  price       Int
  compareAtPrice Int?
  imageUrls   String[] @default([])
  icon        String?
  stock       Int      @default(100)
  active      Boolean  @default(true)
  suitableSizes PetSize[] @default([])
  // Real, provider-editable variant OPTIONS a buyer can pick from — not
  // separate priced/stocked SKUs (price/stock stay single, flat fields on
  // Product itself). Plain string arrays rather than a fixed enum, since
  // options genuinely vary per product (a collar might offer "S, M, L,
  // XL"; a bed might offer "Small, Medium, Large" — different vocabularies,
  // not the same fixed PetSize scale). Empty array = no selection needed
  // for that attribute.
  colorOptions  String[] @default([])
  sizeOptions   String[] @default([])
  createdAt   DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]
  favorites  Favorite[]
}

model CartItem {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  kind      CartItemKind @default(PRODUCT)

  productId String?
  product   Product?     @relation(fields: [productId], references: [id])
  quantity  Int          @default(1)
  // Which color/size option the buyer picked, if the product has any —
  // null when the product has no such options, or none was needed.
  selectedColor String?
  selectedSize  String?

  serviceType ServiceType?
  providerId  String?
  provider    Provider?    @relation(fields: [providerId], references: [id])
  petId       String?
  pet         Pet?         @relation(fields: [petId], references: [id])
  startTime   DateTime?
  endTime     DateTime?
  address     String?
  phone       String?
  priceAmount Int?
  // Snapshot of which real GroomingPackage + size was chosen — captured
  // at add-to-cart time so it survives even if the provider later edits
  // or deletes that package, same principle as the commission snapshot
  // fields on Booking. Only set for GROOMING service items.
  groomingPackageName String?
  groomingSize         PetSize?

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING)
  totalAmount     Int
  razorpayOrderId String?
  paidAt          DateTime?
  createdAt       DateTime    @default(now())

  items    OrderItem[]
  bookings Booking[]
  pawPointsTransactions PawPointsTransaction[]
}

// One row per real points event — earning, redeeming, or reversing either
// (a refund/cancellation claws back points earned on that purchase, and
// gives back points that were spent on it). Balance is ALWAYS computed
// live by summing these rows for a user, never a stored running total —
// same principle as Payout's "amount owed," so it can never silently
// drift from reality. `points` is always stored positive; direction is
// implied by `type`.
//
// Earning rate: 1 point per ₹10 of a purchase's real BASE price (a
// booking's priceAmount before the maintenance fee, or a product's listed
// price) — never on the inflated total the owner actually pays.
// Redemption rate: 1 point = ₹0.25 of real discount, and per product
// decision, redemption is allowed to cover up to 100% of an order.
model PawPointsTransaction {
  id        String                   @id @default(cuid())
  userId    String
  user      User                     @relation(fields: [userId], references: [id])
  type      PawPointsTransactionType
  points    Int
  orderId   String?
  order     Order?                   @relation(fields: [orderId], references: [id])
  bookingId String?
  booking   Booking?                 @relation(fields: [bookingId], references: [id])
  createdAt DateTime                 @default(now())
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id])
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  quantity         Int
  priceAtPurchase  Int
  // Snapshot of the chosen color/size, carried over from the cart item —
  // survives even if the product's available options change later.
  selectedColor    String?
  selectedSize     String?
}

model ActivityEvent {
  id        String       @id @default(cuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  type      ActivityType
  path      String?
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([createdAt])
}

// A user's saved product or provider — never both on the same row. The two
// separate @@unique constraints below (one per relation) stop the same
// user from favoriting the same product twice or the same provider twice,
// while keeping products and providers in one shared table so the wishlist
// page only needs to query one place to show everything a user has saved.
model Favorite {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])
  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id])
  createdAt  DateTime  @default(now())

  @@unique([userId, productId])
  @@unique([userId, providerId])
}
