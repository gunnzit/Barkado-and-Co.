generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  PROVIDER
  ADMIN
}

enum ServiceType {
  WALKING
  SITTING
  GROOMING
  TRAINING
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum CartItemKind {
  PRODUCT
  SERVICE
}

enum ActivityType {
  PAGE_VIEW
  CLICK
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  phone     String?
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())

  pets     Pet[]
  provider Provider?
  bookings Booking[] @relation("OwnerBookings")
  cartItems CartItem[]
  orders    Order[]
  heroPhotos HeroPhoto[]
  showStockPhotos Boolean @default(true)
  address         String?
  addresses       Address[]
  activityEvents  ActivityEvent[]
}

model Address {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  label          String   @default("Home") // Home | Work | Hotel | Other
  fullAddress    String
  googleMapsLink String?
  receiverName   String
  receiverPhone  String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Pet {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  name        String
  breed       String?
  size        PetSize  @default(MEDIUM)
  temperament String?
  notes       String?
  birthday          DateTime?
  weightKg          Float?
  allergies         String?
  medicalHistory    String?
  favoriteTreats    String?
  microchipId       String?
  insuranceProvider String?
  insurancePolicy   String?
  photoUrl          String?
  themeOverride     String?
  createdAt   DateTime @default(now())

  vaccinations Vaccination[]
  bookings     Booking[]
  cartItems    CartItem[]
}

model HeroPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  url       String
  createdAt DateTime @default(now())
}

model Vaccination {
  id           String   @id @default(cuid())
  petId        String
  pet          Pet      @relation(fields: [petId], references: [id])
  vaccineName  String
  type         String   @default("VACCINE")
  dateGiven    DateTime
  nextDueDate  DateTime?
  reminderSent Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Provider {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  bio           String?
  photoUrl      String?
  servicesOffered ServiceType[]
  serviceAreaPin  String?
  radiusKm        Int      @default(5)
  pricePerWalk    Int?
  pricePerSitDay  Int?
  pricePerGroom   Int?
  pricePerTrain   Int?
  verified        Boolean  @default(false)
  ratingAvg       Float    @default(0)
  ratingCount     Int      @default(0)
  isAvailableNow  Boolean  @default(false)
  verificationDocs        String[] @default([])
  verificationSubmittedAt DateTime?
  createdAt       DateTime @default(now())

  bookings     Booking[]
  cartItems    CartItem[]
  availability ProviderAvailability[]
}

model ProviderAvailability {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  dayOfWeek  Int
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())

  @@unique([providerId, dayOfWeek])
}

model Booking {
  id           String        @id @default(cuid())
  type         ServiceType
  status       BookingStatus @default(REQUESTED)
  ownerId      String
  owner        User          @relation("OwnerBookings", fields: [ownerId], references: [id])
  providerId   String
  provider     Provider      @relation(fields: [providerId], references: [id])
  petId        String
  pet          Pet           @relation(fields: [petId], references: [id])
  startTime    DateTime
  endTime      DateTime
  priceAmount  Int
  address      String?
  phone        String?
  latitude     Float?
  longitude    Float?
  razorpayOrderId String?
  paidAt       DateTime?
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id])
  requestExpiresAt DateTime?
  createdAt    DateTime      @default(now())

  report      WalkReport?
  review      Review?
  ownerReview OwnerReview?
}

model WalkReport {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  distanceKm Float?
  durationMin Int?
  photos     String[]
  notes      String?
  createdAt  DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model OwnerReview {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  price       Int
  imageUrls   String[] @default([])
  icon        String?
  stock       Int      @default(100)
  active      Boolean  @default(true)
  suitableSizes PetSize[] @default([])
  createdAt   DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model CartItem {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  kind      CartItemKind @default(PRODUCT)

  productId String?
  product   Product?     @relation(fields: [productId], references: [id])
  quantity  Int          @default(1)

  serviceType ServiceType?
  providerId  String?
  provider    Provider?    @relation(fields: [providerId], references: [id])
  petId       String?
  pet         Pet?         @relation(fields: [petId], references: [id])
  startTime   DateTime?
  endTime     DateTime?
  address     String?
  phone       String?
  priceAmount Int?

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING)
  totalAmount     Int
  razorpayOrderId String?
  paidAt          DateTime?
  createdAt       DateTime    @default(now())

  items    OrderItem[]
  bookings Booking[]
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id])
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  quantity         Int
  priceAtPurchase  Int
}

// Every page view and every click, across the whole app. userId is null for
// signed-out visitors — still logged, just not attributable to an account.
// metadata holds context specific to the event (clicked element's text,
// aria-label, href, tag name).
model ActivityEvent {
  id        String       @id @default(cuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  type      ActivityType
  path      String?
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([createdAt])
}
